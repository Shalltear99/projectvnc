# ── runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# ── persistence ───────────────────────────────────────────────────────────────
# memory  = zero-dependency dev mode (data lost on restart)
# postgres= production control-plane database
DATABASE_DRIVER=memory
DATABASE_URL=postgres://cloudjava:cloudjava@127.0.0.1:5432/cloudjava
REDIS_URL=

# ── auth ──────────────────────────────────────────────────────────────────────
# Optional admin seed, applied at boot. Leave both empty to skip: there is no
# HTTP route that can grant the admin role (that would be privilege escalation).
# An existing account with this email is promoted, not duplicated. Minimum
# password length is 12.
ADMIN_EMAIL=
ADMIN_PASSWORD=

JWT_SECRET=dev-only-change-me-32-characters-minimum
JWT_EXPIRES_IN=7d
VNC_TOKEN_SECRET=dev-only-vnc-token-secret-change-me
VNC_TOKEN_TTL_SECONDS=120

# ── docker / provisioning ─────────────────────────────────────────────────────
# docker = real Docker Engine socket, mock = in-process simulation (never in prod)
DOCKER_DRIVER=mock
DOCKER_SOCKET=/var/run/docker.sock
WORKER_IMAGE=cloudjava-worker:latest
PROVISION_TIMEOUT_MS=5000
VNC_PORT_RANGE_START=5900
VNC_PORT_RANGE_END=6000
WS_PORT_RANGE_START=6000
WS_PORT_RANGE_END=7000
INSTANCE_DEFAULT_TTL_MINUTES=1440
MAX_INSTANCES_PER_USER=2

# ── resource caps per instance (cgroup) ───────────────────────────────────────
INSTANCE_CPU_LIMIT=1.0
INSTANCE_MEMORY_MB=1024
INSTANCE_PIDS_LIMIT=256
INSTANCE_DISK_MB=2048

# ── agents ────────────────────────────────────────────────────────────────────
JANITOR_INTERVAL_MS=60000
METRICS_INTERVAL_MS=2000
INACTIVE_STREAM_TIMEOUT_MS=900000
ABUSE_CPU_PERCENT=95
ABUSE_SUSTAIN_MS=300000

# ── edge proxy ────────────────────────────────────────────────────────────────
# nginx = write the dynamic upstream map + reload, noop = log only (dev)
PROXY_MODE=noop
NGINX_MAP_FILE=/etc/nginx/conf.d/cloudjava_upstreams.map
NGINX_RELOAD_CMD=nginx -s reload
STREAM_PATH_PREFIX=/vnc-stream

# ── payments ──────────────────────────────────────────────────────────────────
# mock | midtrans | xendit | tripay
PAYMENT_PROVIDER=mock
PAYMENT_MODE=auto
# HMAC secret used by the mock provider to sign webhooks in dev/test. Real
# providers use their own server key / callback token instead.
MOCK_PAYMENT_SECRET=mock-payment-secret
MIDTRANS_SERVER_KEY=
XENDIT_CALLBACK_TOKEN=
# Xendit Invoice API key and Tripay API key are read straight from the process
# environment (they have no slot in the validated config schema).
XENDIT_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
