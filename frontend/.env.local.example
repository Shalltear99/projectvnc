# Base URL of the control-plane API (backend/). No trailing slash.
#
# PRODUCTION: leave this EMPTY. The dashboard and the API share one origin
# behind nginx (https://vnc.example.com and /api/*), so relative requests are
# same-origin — no CORS, no cookie SameSite friction, nothing to misconfigure.
#
# LOCAL DEV: set it to the API's address, e.g. http://localhost:4000, because
# `next dev` on :3000 is a different origin from the API on :4000.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Optional: point the noVNC iframe at a worker's websockify directly during local
# development, bypassing the nginx wss proxy. Format: ws://host:port
# Leave empty in production so the viewer uses the /vnc-stream/<id> proxy path.
# NEXT_PUBLIC_VNC_WS_BASE=ws://127.0.0.1:6080

# Optional: force the websocket path prefix (default: vnc-stream)
# NEXT_PUBLIC_VNC_PATH_PREFIX=vnc-stream
